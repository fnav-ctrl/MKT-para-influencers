# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo server-side. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Mercado Pago ===
# Access token del vendedor (server-side).
MP_ACCESS_TOKEN=APP_USR-...
# Secret del webhook para validar la firma x-signature (Panel MP > Webhooks).
MP_WEBHOOK_SECRET=...

# === Resend (emails transaccionales — Fase 3) ===
# Si falta la API key, los envíos son no-op (no rompen el flujo).
RESEND_API_KEY=re_...
# Remitente verificado en Resend.
EMAIL_FROM="Monetizá tu Influencia <hola@tudominio.com>"

# === App ===
# URL pública del sitio (para back_urls y notification_url de MP, y links de email).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
